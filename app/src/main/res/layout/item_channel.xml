<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="130dp" android:layout_margin="6dp" android:padding="8dp"
    android:focusable="true" android:clickable="true" android:background="@drawable/bg_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:layout_gravity="center">
        <ImageView android:id="@+id/logo" android:layout_width="64dp" android:layout_height="64dp"
            android:scaleType="fitCenter" android:contentDescription="@null"/>
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:maxLines="2"
            android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="14sp"/>
    </LinearLayout>
    <TextView android:id="@+id/star" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:text="★" android:textColor="#FFC107" android:textSize="16sp"
        android:visibility="gone"/>
</FrameLayout>
